# ==============================================================================
# 🛠️ [DevOps 실무 가이드] 환경변수(.env) 작성 및 검수 노하우
# ==============================================================================
# 📌 복잡한 프로젝트에서 필수 환경변수를 파악하는 방법:
# 1. 백엔드 개발자에게 질문하거나, 소스 코드 전체 검색으로 `process.env.XXX` 
#    또는 Spring의 `${XXX}` 항목을 찾아 리스트업합니다.
# 2. ⚠️ 핵심 규칙 (Docker 네트워크 호스트명):
#    - 로컬 개발용 코드는 `DB_HOST=localhost`로 되어있더라도,
#    - 도커 환경에서는 반드시 docker-compose.yml의 서비스명인 `DB_HOST=db`로 적어야 합니다!
# 3. ⚠️ 보안 원칙:
#    - `.env.example`: 실제 비밀번호 없는 템플릿 (Git 커밋 ⭕)
#    - `.env`: 실제 운영 서버 접속 비밀번호 파일 (Git 커밋 ❌ -> .gitignore 필수)
# ==============================================================================

# 백엔드 서버 바인딩 포트
PORT=5000

# 데이터베이스 접속 설정 (Docker 통신 시 서비스명 'db' 사용)
DB_HOST=db
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=myapp

