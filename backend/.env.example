# ==============================================================================
# 🛠️ [1단계 vs 2단계 DevOps 체크포인트 비교]
# ==============================================================================
# [1단계 체크포인트]
# -> 서버 기본 포트 및 DB 접속 기초 설정 (DB_HOST=db)

# [2단계 체크포인트]
# -> 백엔드 기능 확장(로그인, Gemini AI)에 따른 신규 환경변수 추가 (JWT_SECRET, GEMINI_API_KEY)
# -> 배포 담당자는 운영 서버의 backend/.env 파일에 실제 운영 비밀키 값을 채워 넣어야 합니다.
# ==============================================================================

# [1단계 항목]
PORT=5000
DB_HOST=db
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=myapp

# [2단계 추가 항목]
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here


# [2단계 추가] 보안 인증 및 AI 서비스 환경변수
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here